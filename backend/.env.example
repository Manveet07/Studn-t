# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit or share it.
PORT=5000

# MongoDB Atlas connection string (Node.js driver format)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/studnt?retryWrites=true&w=majority

# Long random string used to sign JWTs — generate one, e.g. `openssl rand -hex 32`
JWT_SECRET=replace-with-a-long-random-string

# Exact origin(s) of the frontend, comma-separated, no trailing slash
FRONTEND_ORIGIN=http://127.0.0.1:5500

# development | production
NODE_ENV=development
