{
  "info": {
    "name": "Studn't Phase 2 API Tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health check",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "Register",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Demo Student\",\n  \"username\": \"demo_student_2026\",\n  \"email\": \"demo.student@example.com\",\n  \"password\": \"ChangeThis123!\",\n  \"university\": \"Demo University\",\n  \"year\": \"2nd\",\n  \"branch\": \"CSE AI\",\n  \"academicSkills\": [\n    \"Java\",\n    \"DSA\"\n  ]\n}"
        },
        "url": "{{baseUrl}}/auth/register"
      }
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"identifier\": \"demo_student_2026\",\n  \"password\": \"ChangeThis123!\"\n}"
        },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "Current user (requires token)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/auth/me"
      }
    },
    {
      "name": "List doubts",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/doubts"
      }
    },
    {
      "name": "Create doubt (requires token)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"How does a Java stack work?\",\n  \"description\": \"I need help understanding push and pop operations with an example.\",\n  \"category\": \"academic\",\n  \"tags\": [\n    \"Java\",\n    \"DSA\"\n  ],\n  \"urgency\": \"medium\"\n}"
        },
        "url": "{{baseUrl}}/doubts"
      }
    },
    {
      "name": "Leaderboard",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/users/leaderboard"
      }
    }
  ]
}